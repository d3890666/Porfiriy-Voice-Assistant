{
  "version": "1.2.4-porfiriy.7",
  "name": "Quasar Bridge Porfiriy Edition",
  "target": "yandex_station_2",
  "description": "Unified Station distribution: Native WebSocket audio streaming, Squeezelite, Station AirPlay, 8s fast auto-ducking watchdog and bi-directional Music Assistant volume sync",
  "bundled_components": [
    "quasar-bridge",
    "squeezelite",
    "squeezelite_service",
    "squeezelite_init",
    "station-airplay",
    "station_airplay_service",
    "station_airplay_init",
    "station_ducking_service",
    "station_ducking_init",
    "set_volume.sh",
    "asound.conf",
    "control.sh",
    "runtime.env"
  ],
  "features": [
    "ws_audio_stream",
    "multi_turn_dialogue",
    "home_assistant_synonyms",
    "squeezelite_music_assistant",
    "squeezelite_hardware_volume",
    "station_airplay_music_assistant",
    "auto_ducking_on_hotword",
    "voice_volume_sync"
  ]
}
