{
  "version": "1.2.4-porfiriy.9",
  "name": "Quasar Bridge Porfiriy Edition",
  "target": "yandex_station_2",
  "description": "Unified Station distribution: Native WebSocket audio streaming, Squeezelite and Station AirPlay",
  "bundled_components": [
    "quasar-bridge",
    "squeezelite",
    "squeezelite_service",
    "squeezelite_init",
    "station-airplay",
    "station_airplay_service",
    "station_airplay_init",
    "control.sh",
    "runtime.env"
  ],
  "features": [
    "ws_audio_stream",
    "multi_turn_dialogue",
    "home_assistant_synonyms",
    "squeezelite_music_assistant",
    "station_airplay_music_assistant"
  ]
}
