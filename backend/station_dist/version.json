{
  "version": "1.2.4-porfiriy.15",
  "name": "Quasar Bridge Porfiriy Edition",
  "target": "yandex_station_2",
  "description": "Unified Station distribution: Master hardware amplifier volume via Alice/ring, playback controls (pause/stop/play/next) via Porfiriy, Squeezelite output to music_duck with instant -75% hardware ducking",
  "bundled_components": [
    "quasar-bridge",
    "squeezelite",
    "squeezelite_service",
    "squeezelite_init",
    "station-airplay",
    "station_airplay_service",
    "station_airplay_init",
    "alice_watcher_service",
    "alice_watcher_init",
    "control.sh",
    "runtime.env"
  ],
  "features": [
    "ws_audio_stream",
    "multi_turn_dialogue",
    "home_assistant_synonyms",
    "squeezelite_music_assistant",
    "station_airplay_music_assistant",
    "server_side_ha_ducking",
    "auto_server_host_sync",
    "universal_hardware_ducking_music_duck"
  ]
}
